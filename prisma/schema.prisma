generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
}

model Villa {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  location    String
  price       Float
  description String
  images      String[]
  amenities   String[]
  rating      Float    @default(4.5)
  bedrooms    Int
  bathrooms   Int
  featured    Boolean  @default(false)
  createdAt   DateTime @default(now())

  bookings Booking[]
}

model Booking {
  id             String        @id @default(auto()) @map("_id") @db.ObjectId
  villaId        String        @db.ObjectId
  villa          Villa         @relation(fields: [villaId], references: [id])
  customerName   String
  email          String
  phone          String
  address        String
  guests         Int
  specialRequest String?
  status         BookingStatus @default(Pending)
  createdAt      DateTime      @default(now())
}

enum BookingStatus {
  Pending
  Approved
  Rejected
}
